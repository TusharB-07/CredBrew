DATABASE_URL=postgres://credbrew:credbrew@localhost:5432/credbrew
JWT_SECRET=change-me-64-chars-minimum-length-for-security
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=credbrew
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
PUBLIC_BASE_URL=http://localhost:8080
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CredBrew <no-reply@credbrew.local>"
RUST_LOG=info
EMAIL_PER_MIN=60

# v1.0 Phase 2: KMS master key for sealing Ed25519 signing-key seeds at rest.
# MUST be at least 16 characters. In production, use a strong random value
# (e.g. `openssl rand -base64 48`). If this is lost, all signed credentials
# become unverifiable (the seeds cannot be decrypted).
CREDBREW_MASTER_KEY=dev-only-change-me-to-a-strong-random-value