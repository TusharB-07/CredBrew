  "query": "\n        UPDATE participant_types\n        SET name = COALESCE($2, name),\n            badge_enabled = COALESCE($3, badge_enabled),\n            certificate_enabled = COALESCE($4, certificate_enabled)\n        WHERE id = $1\n        RETURNING id, event_id, name, badge_enabled, certificate_enabled\n        ",
